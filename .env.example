# =============================================
# Facebook Group Automation - Example Config
# Copy this file to '.env' and update your values
# =============================================

# Path to your exported Facebook session cookies JSON file
COOKIE_FILE=./facebookcookies.json

# Target Posting Source URL
SOURCE_URL=https://www.facebook.com/share/YOUR_URL_HERE/

# Exact match validation for target profile name
TARGET_PROFILE_NAME=Your Name Here

# Path to the spreadsheet containing Facebook group names and profile columns
GROUP_LIST_FILE=./Facebook-Group.xlsx